APP_URL=http://localhost:8888
BETTER_AUTH_URL=http://localhost:8888
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
ALLOWED_GOOGLE_EMAILS=you@example.com

# Netlify provides the Database connection and Blobs context automatically.
# No database URL, Netlify site ID, or Netlify API token is required by the application.
NETLIFY_BLOBS_STORE=agentboard-assets
